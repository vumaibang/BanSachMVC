@model CategoryListViewModel
@{ ViewData["Title"] = "Quản lý danh mục"; }
<div class="page-heading"><h1>Quản lý danh mục</h1><a class="btn btn-primary" asp-area="Admin" asp-controller="Categories" asp-action="Create">+ Thêm danh mục</a></div>
<form method="get" class="filter-toolbar"><input asp-for="SearchTerm" class="form-control" aria-label="Tìm kiếm" placeholder="Tìm kiếm…" /><select asp-for="StatusFilter" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="Active">Hoạt động</option><option value="Inactive">Ngừng hoạt động</option></select><button class="btn btn-primary">Lọc</button><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">Đặt lại</a></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Danh mục</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.CategoryName</td><td>@item.Description</td><td>@(item.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td class="actions"><a asp-route-id="@item.CategoryId" asp-area="Admin" asp-controller="Categories" asp-action="Edit">Sửa</a><a asp-route-id="@item.CategoryId" class="text-danger me-3" asp-area="Admin" asp-controller="Categories" asp-action="Delete">Xóa</a></td></tr> }</tbody></table>@if (Model.Items.Count == 0) { <p>Không có dữ liệu phù hợp.</p> }</div>
@if (Model.TotalPages > 1) { <nav class="pagination-row" aria-label="Phân trang">@for (var n = Math.Max(1,Model.PageNumber-3); n <= Math.Min(Model.TotalPages,Model.PageNumber+3); n++) { <a class="btn @(n == Model.PageNumber ? "btn-primary" : "btn-outline-secondary")" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-PageNumber="@n"  asp-area="Admin" asp-controller="Categories" asp-action="Index">@n</a> }</nav> }
<p class="text-muted mt-3">@Model.Total mục · Trang @Model.PageNumber / @Model.TotalPages</p>
