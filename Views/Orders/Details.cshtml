@model OrderViewModel
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container page-space"><a asp-area="" asp-controller="Orders" asp-action="Index">← Danh sách đơn hàng</a><h1 class="mt-3">Đơn hàng #@Model.Order.OrderId</h1><partial name="_Feedback" /><partial name="_OrderInfo" model="Model.Order" />@if (Model.Order.Status == "Pending") { <form class="mt-4" method="post" asp-area="" asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Order.OrderId"><button class="btn btn-outline-danger" onclick="return confirm('Bạn muốn hủy đơn hàng này?')">Hủy đơn hàng</button></form> }</div>
